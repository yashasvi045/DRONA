# Copy this file to .env and fill in your values. Never commit .env.

# Private key of the deployer wallet (with 0x prefix)
# For local Hardhat dev: use Account #0 from `npx hardhat node` output
# For testnet/mainnet: use your own wallet key - NEVER share or commit this
DEPLOYER_PRIVATE_KEY=your_private_key_here

# RPC URL for the target network (e.g. Alchemy / Infura / QuickNode)
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_api_key_here

# Block explorer API key for contract verification (optional)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
